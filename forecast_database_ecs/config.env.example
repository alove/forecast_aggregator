# Source this file before election_forecasts_ecs.sh, or export only the values
# you need. No passwords belong here; AWS Secrets Manager generates them.

export AWS_REGION='us-east-2'
export MY_APP='rhubarb'
export STAGE='staging'

export STACK_NAME='rhubarb-staging-election-forecasts-postgres'
export REPO_NAME='rhubarb/election-forecasts-postgres'

export DB_NAME='election_forecasts'
export ADMIN_USER='forecast_admin'
export READER_USER='rhubarb_forecast_reader'
export DB_PORT='5432'

# Match the Stack Overflow survey pattern, or replace with a narrow CIDR.
export ALLOWED_CIDR='0.0.0.0/0'

export DATA_DIR="$HOME/f_collector/collected_data"
export EFC_CONTACT_EMAIL='you@example.com'

# Optional network overrides when there is no usable default VPC.
# export VPC_ID='vpc-...'
# export SUBNET_IDS='subnet-a subnet-b'

# Optional capacity overrides.
export CPU='1024'
export MEMORY='2048'

# Refresh behavior.
export COLLECT_SAVE_RAW='true'
export ALLOW_PARTIAL_COLLECT='false'
# export COLLECT_SOURCES='electindex election-statsheet grant-williams race-to-the-wh'

# GitHub-canonical sync runner.
export FORECAST_GIT_REMOTE='origin'
export FORECAST_GIT_BRANCH='main'
